# Required machine-to-machine credential for points/stock reports and image upload.
# Generate a random value with at least 32 characters.
INGEST_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Temporary compatibility alias for older deployments. Prefer INGEST_TOKEN.
# API_TOKEN=

DATABASE_URL=sqlite:///./data/database.db
# Optional database restore upload limit in bytes (default: 268435456).
# DATABASE_IMPORT_MAX_BYTES=268435456
TZ=Asia/Shanghai
